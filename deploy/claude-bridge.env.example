# Environment for deploy/claude-bridge.service (EnvironmentFile=/etc/claude-bridge.env).
# Install with:  sudo install -m 600 deploy/claude-bridge.env.example /etc/claude-bridge.env
# systemd reads the file as root, so it can stay root-owned and private.
# Values here override the unit's Environment= lines. Format: KEY=value, one per line.
# Every variable is optional; an unset or empty value means "use the default".
# Running without systemd? Export the same variables in your shell before run_bridge.sh.

# Address to listen on. Default: 127.0.0.1 (this machine only).
# 0.0.0.0 exposes the bridge on every interface. If you do that, set BRIDGE_API_KEY.
#BRIDGE_HOST=127.0.0.1

# Port to listen on. Overrides the port saved in the GUI's Settings tab.
# Default: the GUI setting (5001 unless changed).
#BRIDGE_PORT=5001

# If set, every /v1/* route (chat/completions, models, chunked/process) requires
#   Authorization: Bearer <this value>
# Put the same value in SillyTavern's "API key" field for the connection.
# Generate one with:  openssl rand -hex 32
#BRIDGE_API_KEY=

# If set, the dashboard (/) and every /api/* route require HTTP Basic auth:
# any username, this password. The browser prompts once per session.
#BRIDGE_DASHBOARD_PASSWORD=

# Comma-separated list of browser origins allowed to call the bridge cross-origin,
# e.g. https://st.example.ts.net, or "*" for any.
# SillyTavern does NOT need this: it calls the bridge from its Node server.
# Unset: no CORS headers, unless BRIDGE_HOST is 0.0.0.0 or :: (then any origin, as upstream).
#BRIDGE_CORS_ORIGINS=
